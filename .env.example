# Required for real runs (identification, listing copy, computer use)
ANTHROPIC_API_KEY=

# Optional model overrides
OFFLOAD_VISION_MODEL=claude-opus-5-5
OFFLOAD_DETECT_MODEL=claude-sonnet-5-5
OFFLOAD_TEXT_MODEL=claude-sonnet-5-5
OFFLOAD_COMPUTER_MODEL=claude-opus-5-5

# eBay (official Sell APIs). Get these from developer.ebay.com
EBAY_ENV=sandbox            # sandbox | production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_USER_REFRESH_TOKEN=    # per user, from the OAuth consent flow

# Where per-user browser sessions (cookies) are stored. Keep outside the repo in production.
OFFLOAD_SESSIONS_DIR=./sessions
